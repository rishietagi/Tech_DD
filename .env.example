# Backend
DATABASE_URL=sqlite:///./techdd.db
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Scope-of-work generator: placeholder | rules | llm
# "rules"  - deterministic engine only (no API calls, no cost)
# "llm"    - rules pick the workstreams, Claude authors the prose in KPMG voice
SCOPE_GENERATOR=rules

# Anthropic API - required only when SCOPE_GENERATOR=llm.
# Leave blank to fall back to the deterministic generator automatically.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LLM_MAX_TOKENS=16000

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

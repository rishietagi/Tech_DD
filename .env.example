# Copy to .env and fill in. Never commit .env.

# Database — SQLite in dev, Postgres in prod.
DATABASE_URL=sqlite:///./techdd.db
CORS_ORIGINS=http://localhost:3000

# The intelligence pipeline (Phase 7). off = deterministic everywhere, even with a key;
# auto = the model runs for every skill whose key is present.
AI_MODE=off
# Skills to keep deterministic under auto, comma-separated (see Workspace > AI & skills).
AI_DISABLED_SKILLS=

# Gemini — only used when AI_MODE=auto. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kept only for "placeholder"; it no longer selects rules vs LLM.
SCOPE_GENERATOR=rules

# Folder the shared-drive scan walks. Relative paths resolve from backend/.
SHARED_DRIVE_ROOT=../shared-drive/project-kiln
